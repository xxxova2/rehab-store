{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@rehab/ui": ["../../packages/ui/src"],
      "@rehab/ui/*": ["../../packages/ui/src/*"],
      "@rehab/tokens": ["../../packages/tokens/src"],
      "@rehab/tokens/*": ["../../packages/tokens/src/*"],
      "@rehab/three": ["../../packages/three/src"],
      "@rehab/three/*": ["../../packages/three/src/*"],
      "@rehab/types": ["../../packages/types/src"],
      "@rehab/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
