{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./.medusa/server",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@rehab/types": ["../../packages/types/src"]
    }
  },
  "include": ["./src/**/*", "medusa-config.ts"],
  "exclude": ["node_modules", ".medusa", "dist"]
}
